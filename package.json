    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@codemirror/view": "^6.38.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "latest",
    "obsidian": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
