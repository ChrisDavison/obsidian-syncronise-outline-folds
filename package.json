{
  "name": "synchronise-outline-folds",
  "version": "0.1.1",
  "private": true,
  "description": "Synchronise heading folds between the core Outline and the active Markdown document.",
  "license": "MIT",
  "author": "Chris Davison",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
